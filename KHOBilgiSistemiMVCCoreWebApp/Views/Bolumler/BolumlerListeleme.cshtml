@using EntityLayer.Concrete

@model List<BolumTbl>
@{
    ViewData["Title"] = "BolumlerListeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-lg">
            <h2 class="text-primary">Bölümler Düzenleme</h2>
        </div>

        <div class="col-6 text-end">
            <a asp-controller="BolumlerController" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i>&nbsp;Yeni Birim Yarat</a>
        </div>
    </div>
    <br />
    <table class="table table-hover table-sm">
        <thead>
            <tr>
                <th scope="col" width="10%">#</th>
                <th scope="col" width="80%">Bölüm Adı</th>
                <th scope="col" width="5%"></th>
                <th scope="col" width="5%"></th>

            </tr>
        </thead>
        @foreach (var item in Model)
        {
            <tr>
                <td scope="row">@item.BolumID</td>
                <td scope="row">@item.BolumAdi</td>
                <td scope="row"><a href="#"><i class="bi bi-pencil-square"></i></a></td>
                <td scope="row"><a href="#"><i class="bi bi-trash"></i></a></td>
            </tr>
        }
    </table>
</div>





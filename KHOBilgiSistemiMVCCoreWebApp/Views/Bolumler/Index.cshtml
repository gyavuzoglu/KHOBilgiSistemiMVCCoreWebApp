@using EntityLayer.Concrete
@model List<BolumTbl>
@{
    ViewData["Title"] = "Bolum Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-lg">
                <h3 class="card-title">Bölümler Düzenleme</h3>
            </div>
            <br />

            <div class="col-6 text-end">
                <a href="/Bolumler/BolumAdd" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Bölüm Yarat</a>

            </div>
        </div>
        <br />
        <div style="width:70%;margin:auto;">
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="10%">ID</th>
                        <th scope="col" class="text-left" width="80%">Bölüm Adı</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>
                </thead>
                @if (Model.Count() > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">
                            <td scope="col" class="text-left" width="10%">@item.BolumID</td>
                            <td scope="col" class="text-left" width="80%">@item.BolumAdi</td>
                                        
                            <td scope="row" class="text-center">
                                <a href="/Birimler/BirimGet/@item.BolumID">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </a>

                            </td>
                            <td scope="row" class="text-center">
                                <a data-bs-toggle="modal" data-bs-target="#Sil_@item.BolumID">
                                    <i class="fa-solid fa-trash text-primary"></i>
                                </a>
                                @* Modal Sil *@
                                <div class="modal fade" id="Sil_@item.BolumID" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="SilModalLongTitle">Bölüm Silme</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <h5>Bu Birimi silmek istediğinize emin misiniz ? </h5>
                                            </div>
                                            <div class="modal-footer">
                                                @Html.ActionLink("Sil", "BolumDelete", new { id = @item.BolumID }, new { @class = "btn btn-danger" })
                                                <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center text-danger" colspan="4">Herhangi bir kayıt bulunamadı.</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>


@using EntityLayer.Concrete
@model UserTbl

<div style="background-color: #e5e7e9;" class="container py-4">

    <div class="row d-flex justify-content-center align-items-center">

        <div class="col-12 col-md-8 col-lg-6 col-xl-5">

            <div class="card shadow-2-strong" style="border-radius: 1rem;">
                <form asp-controller="Kullanicilar" asp-action="Login" method="post">
                    <div class="card-body p-4 text-center">
                        @* <img src="~/img/msu_kho_brove.png" width="80" height="100" /> *@

                        <h4 class="m-3">Dekanlık Bilgi Sistemi</h4>


                        </br>

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="text" id="typeEmailX-2" name="UserTC" class="form-control" placeholder="TC Kimlik numaranız" />

                        </div>

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="password" id="typePasswordX-2" name="Password" class="form-control" placeholder="Şifre" />

                        </div>

                        <!-- Checkbox -->
                        <div class="d-flex justify-content-end mb-4">
                            <a class="py-1" href="#" for="form1Example3"> Şifremi Unuttum</a>
                        </div>

                        <button class="btn btn-primary btn-block" type="submit">
                            <i class="fa-solid fa-right-to-bracket"></i> &nbsp;
                            Giriş Yap
                        </button>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>


@using EntityLayer.Concrete
@model List<PersonelTbl>

@{
    ViewData["Title"] = "BirimlerListeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-lg">
                <h3 class="card-title">Personel Düzenleme</h3>
            </div>
            <br />

            <div class="col-6 text-end">
                <a href="/Birimler/BirimAdd" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Birim Yarat</a>

            </div>
        </div>
        <br />
        <div style="width:70%;margin:auto;">
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="15%">Personel TC</th>
                        <th scope="col" class="text-left" width="25%">Adı</th>
                        <th scope="col" class="text-left" width="25%">Soyadı</th>
                        <th scope="col" class="text-left" width="25%">Birimi</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>

                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr class="table-light">
                        <td scope="row" class="text-left text-primary">@item.PersonelTC</td>
                        <td scope="row" class="text-left text-primary">@item.Adi</td>
                        <td scope="row" class="text-left text-primary">@item.Soyadi</td>
                        <td scope="row" class="text-left text-primary">@item.BirimlerTbl.BirimAdi</td>
                        <td scope="row" class="text-center">
                            <a href="/Personel/PersonelGet/@item.PersonelTC">
                                <i class="fa-solid fa-pen-to-square text-primary"></i>
                            </a>

                        </td>
                        <td scope="row" class="text-center">
                            <a data-bs-toggle="modal" data-bs-target="#Sil_@item.PersonelTC">
                                <i class="fa-solid fa-trash text-primary"></i>
                            </a>
                            @* Modal Sil *@
                            <div class="modal fade" id="Sil_@item.PersonelTC" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="SilModalLongTitle">Personel Silme</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <h5>Bu Personeli silmek istediğinize emin misiniz ? </h5>
                                        </div>
                                        <div class="modal-footer">
                                            @Html.ActionLink("Sil", "PersonelDelete", new { id = @item.PersonelTC }, new { @class = "btn btn-danger" })
                                            <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>












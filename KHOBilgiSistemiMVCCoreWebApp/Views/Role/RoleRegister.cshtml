@model RoleViewModel
@{
    ViewData["Title"] = "RoleRegister";
    Layout = "~/Views/Shared/_Layout.cshtml"; //Admin layout olacak
}


<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Rol Kayıt</h3>

            <br /><br /><br />
            <div style="width:70%;margin:auto;">
                <form method="post" class="m-t" role="form" asp-controller="Role" asp-action="RoleRegister">
                    <div class="form-group">

                        <input type="text" class="mb-3 form-control" asp-for="@Model.Name" placeholder="Rol Adı" required="" />
                        <span asp-validation-for="@Model.Name" class="text-danger"></span>

                    </div>
                    <br />
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <br />

                    <div class="text-danger" asp-validation-summary="ModelOnly">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
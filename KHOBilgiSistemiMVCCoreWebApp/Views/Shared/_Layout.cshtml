@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>KHO Dekanlık Bilgi Sistemi</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootswatch-flatly-theme/bootstrap.css"/>
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
        
</head>
<body style="background-color:white">
    <div class="text-center"><img src="~/img/dbstasarim.jpg" alt="" width="1500" height="100"></div>
    @if(@ViewBag.RoleName==null)
    {
        @await Html.PartialAsync("LoginProfileNavBar")
    }
    else
    {
        @if (@ViewBag.RoleName == "Öğrenci")
        {
            @await Html.PartialAsync("OgrenciProfileNavBar")
        }

        @if (@ViewBag.RoleName == "Akademik Danışman")
        {
            @await Html.PartialAsync("AkademikDanismanProfileNavBar")
        }

        @if (@ViewBag.RoleName == "Yönetici")
        {
           
            @await Html.PartialAsync("YoneticiProfileNavBar")
        }

        @if (@ViewBag.RoleName == "Yoklama Kayıt")
        {

            @await Html.PartialAsync("YoklamaKayitProfileNavBar")
        }

        //diğerleri de buraya yazılacak
    }

    @* Burada oturum açmaya göre farklı partial-navbar gelecek if ve session kontrolü olacak. *@
    @RenderBody()

    
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <style>
        .overlay {
            display: none;
            align-items: center;
            justify-content: center;
            background-color: rgba(0,0,0,0.8);
            position: absolute;
            z-index: 100;
            height: 100%;
            width: 100%;
            top: 0;
            left: 0;
    </style>

    <div id="overlay" class="overlay">
        <div class="loader text-center">
            <img src="../../img/spinner4.gif" />
            <h4 style="color:white;">Sayfa yükleniyor</h4>

        </div>

    </div>
    <script>
        document.getElementById('spinner')
            .addEventListener('click', function (e) {
                document.getElementById('overlay').style.display = 'flex';
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

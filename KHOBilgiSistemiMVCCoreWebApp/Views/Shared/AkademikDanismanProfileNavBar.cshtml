@* Akademik Danışman Profile NavBar *@

<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="#">
            <img src="~/img/msu_kho_brove.png" alt="" width="40" height="50">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarColor03">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" asp-action="Index" asp-controller="AkademikDanisman" asp-area="Home">
                        Ana Sayfa
                        <span class="visually-hidden">(current)</span>
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="true">Değerlendirme İşlemleri</a>
                    <div class="dropdown-menu">
                        
                        <a class="dropdown-item" asp-action="OgrencileriGetirForm" asp-controller="OgrenciDegerlendirmeleri" asp-area="AkademikDanismanArea">Öğrenciye Değerlendirme Yazma İşlemleri</a>
                        <a class="dropdown-item" asp-action="TumOgrenciDegerlendirmelerimiGetirForm" asp-controller="OgrenciDegerlendirmeleri" asp-area="AkademikDanismanArea">Tüm Öğrenci Değerlendirmelerimi Listele</a>
                        <a class="dropdown-item" asp-action="KisimlariGetirForm" asp-controller="KisimDegerlendirmeleri" asp-area="AkademikDanismanArea">Kısma Değerlendirme Yazma İşlemleri</a>
                        <a class="dropdown-item" asp-action="TumKisimDegerlendirmelerimiGetirForm" asp-controller="KisimDegerlendirmeleri" asp-area="AkademikDanismanArea">Tüm Kısım Değerlendirmelerimi Listele</a>                  
                    </div>

                </li>


                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Diğer İşlemler</a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-action="Index" asp-controller="KisiselBilgi" asp-area="AkademikDanismanArea">Kişisel Bilgilerim</a>
                    </div>

                </li>
                <li class="nav-item"><a class="nav-link" style="color:coral" href="#">Mesajlarım</a></li>
            </ul>

            <ul class="nav navbar-nav navbar-right">
                <li class="nav-item">
                    <a class="nav-link" style="color:red">
                        <i class="fa-solid fa-key"></i>&nbsp; @ViewBag.RoleName
                    </a>
                </li>
                &nbsp;
                <li class="nav-item">
                    <a class="nav-link" style="color:darkturquoise">
                        <i class="fa-solid fa-user"></i>&nbsp; @ViewBag.UserName
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" style="color:lawngreen" asp-action="Logout" asp-controller="Home" asp-area="Home" asp-route-returnUrl="/Home/Index">
                        <i class="fa-solid fa-right-from-bracket"></i>&nbsp; Çıkış yap
                    </a>
                </li>

            </ul>
        </div>
    </div>
</nav>


@model UserSignInViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@* Login Home/Index Sayfası *@

<div style="background-color: white;" class="container py-4">

    <div class="row d-flex justify-content-center align-items-center">

        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            </br >
            </br >

            <div class="card text-white bg-primary mb-3 shadow-2-strong" style="border-radius: 1rem;">
                <form method="post" asp-action="Index" asp-controller="Home">

                    <h3 class="card-header text-center">Dekanlık Bilgi Sistemi</h3>

                    <div class="card-body p-4 text-center">

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="text" asp-for="UserName" class="form-control" placeholder="TC Kimlik numaranız" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="password" asp-for="Password" class="form-control" placeholder="Şifre" />
                            <span asp-validation-for="Password" class="text-danger"></span>

                        </div>

                        <div data-mdb-input-init class="form-outline mb-4">
                            @Html.DropDownListFor(x=>x.RoleID,new SelectList(ViewBag.rolelist,"Value","Text"),"Giriş Türü Seçiniz",new{ @class="form-control form-select"})
                            @Html.ValidationMessageFor(x => x.RoleID, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end mb-4">
                            <a class="py-1" href="#" for="form1Example3"> Şifremi Unuttum</a>
                        </div>
                        <div class="d-grid gap-2">
                        <button class="btn btn-lg btn-success" type="submit">
                            <i class="fa-solid fa-right-to-bracket"></i> &nbsp;
                            Giriş Yap
                        </button>
                        </div>

                    </div>
                </form>
                
                </div>
            </div>
        </div>
    </div>
</div>




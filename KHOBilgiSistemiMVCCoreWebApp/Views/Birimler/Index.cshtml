@using EntityLayer.Concrete
@model List<BirimlerTbl>

@{
    ViewData["Title"] = "BirimlerListeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-lg">
                <h3 class="card-title">Birimler Düzenleme</h3>
            </div>
            <br />
            <div class="col-6 text-end">
                <a class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#BirimEkle"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Birim Yarat</a>

            </div>
        </div>
        <br />
        <div style="width:70%;margin:auto;">
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="10%">Id</th>
                        <th scope="col" class="text-left" width="80%">Birim Adı</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>

                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr class="table-light">
                        <td scope="row" class="text-left text-primary">@item.BirimID</td>
                        <td scope="row" class="text-left text-primary">@item.BirimAdi</td>
                        <td scope="row" class="text-center">
                            <a data-bs-toggle="modal" data-bs-target="#Guncelle_@item.BirimID">
                                <i class="fa-solid fa-list text-primary"></i>
                            </a>
                            @* Modal Birim Güncelleme *@
                            <div class="modal fade" id="Guncelle_@item.BirimID" tabindex="-1" role="dialog" aria-labelledby="GuncelleModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="GuncelleModalLongTitle">Birim Güncelleme</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>

                                        <form method="post">
                                            <div class="modal-body">
                                                <label class="form-label">Birim Adı</label>
                                                <input type="text" class="form-control" name="BirimAdi" value="@item.BirimAdi" />
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-primary" type="submit" asp-controller="Birimler" asp-action="BirimUpdate">
                                                    Güncelle
                                                </button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div>
                        </td>
                        <td scope="row" class="text-center">
                            <a data-bs-toggle="modal" data-bs-target="#Sil_@item.BirimID">
                                <i class="fa-solid fa-trash text-primary"></i>
                            </a>
                            @* Modal Sil *@
                            <div class="modal fade" id="Sil_@item.BirimID" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="SilModalLongTitle">Birim Silme</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <h5>Bu Birimi silmek istediğinize emin misiniz ? </h5>
                                        </div>
                                        <div class="modal-footer">
                                            @Html.ActionLink("Sil", "BirimDelete", new { id = @item.BirimID }, new { @class = "btn btn-danger" })
                                            <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>

@* Modal Birim Ekle *@
<div class="modal fade" id="BirimEkle" tabindex="-1" role="dialog" aria-labelledby="EkleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EkleModalLongTitle">Birim Ekleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <label class="form-label">Birim Adı</label>
                    <input type="text" class="form-control" name="BirimAdi" placeholder="Birim adını giriniz..." />
                </div>
                <div class="modal-footer">
                    <button type="submit" asp-controller="Birimler" asp-action="BirimAdd" class="btn btn-primary">
                        Ekle
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                </div>
            </form>
        </div>
    </div>
</div>







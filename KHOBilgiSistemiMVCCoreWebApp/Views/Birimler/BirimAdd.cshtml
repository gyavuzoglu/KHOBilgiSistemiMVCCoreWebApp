@using EntityLayer.Concrete
@model BirimlerTbl

@{
    ViewData["Title"] = "BirimEkleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Birim Ekleme</h3>

            <br /><br /><br />
            <div style="width:70%;margin:auto;">
                @using(Html.BeginForm("BirimAdd", "Birimler", FormMethod.Post))
                {
                    <label style="display:none;">Birim ID</label>
                    @Html.TextBoxFor(x => x.BirimID, new { style = "display:none;", @class = "form-control" })
                    <label>Birim Adı</label>
                    @Html.TextBoxFor(x => x.BirimAdi, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BirimAdi,"",new {@class="text-danger"})
                    <br /><br/><br/>
                    <button type="submit" class="btn btn-primary">Ekle</button>

               }
            </div>
        </div>
    </div>
</div>



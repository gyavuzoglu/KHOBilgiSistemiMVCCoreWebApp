@model EntityLayer.Concrete.BirimlerTbl

@{
    ViewData["Title"] = "Birim Update";
    Layout = "_Layout";
}
<div class="mt-3">
    <div class="container p-3">
        <h2> Birim Düzenleme </h2>

        @using(Html.BeginForm("BirimUpdate","Birimler",FormMethod.Post))
        {
            //@Html.Label("Birim ID")
            @Html.HiddenFor(x=>x.BirimID, new {@class="form-control"})
            @Html.Label("Birim Adı")
            @Html.TextBoxFor(x => x.BirimAdi, new { @class = "form-control" })
            <br />
            <button class="btn btn-outline-primary">Güncelle</button>
            <button type="reset" class="btn btn-primary" onclick="history.back()">İptal</button>
        }
    </div>

</div>
@using KHOBilgiSistemiMVCCoreWebApp.Areas.AkademikDanismanArea.Models
@model OgrenciDegerlendirmeTblveList

@{
    ViewData["Title"] = "Öğrenci Değerlendirme Ekleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-3" style="max-width: 70rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-8">
                <h3 class="text-primary">Öğrenci Değerlendirme İşlemleri</h3>
                <h4 class="text-primary">Değerlendirilen Öğrenci : ViewBag.Adi ViewBag.Soyadi</h4>
                <h4 class="text-primary">Değerlendirilen Sınıf - Kısım : ViewBag.Sinif / ViewBag.KisimAdi</h4>
               
            </div>
            <div class="col-4 text-end">
                <a href="@Url.Action("OgrencileriGetir","OgrenciDegerlendirmeleri", new {sinif=ViewBag.Sinif, KisimAdi=ViewBag.KisimAdi, EOYiliID=ViewBag.EOYiliID, Donem=ViewBag.Donem, area ="AkademikDanismanArea"})" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Başka Sınıf-Kısım Seç</a>

            </div>

            <div style="width:90%;margin:auto;">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr class="table-primary">
                            <th scope="col" class="text-left" width="8%">Sıra No</th>
                            <th scope="col" class="text-left" width="12%">Değerlendirme ID</th>
                            <th scope="col" class="text-left" width="10%">Tarih-Saat</th>
                            <th scope="col" class="text-left" width="70%">Değerlendirme</th>
                            
                        </tr>
                    </thead>
                    @{
                        int adet = 1;
                    }
                    @if (Model.OgrenciDegerlendirmeleriTblList.Count() > 0)
                    {
                        @foreach (var item in Model.OgrenciDegerlendirmeleriTblList)
                        {
                            <tr class="table-light">
                                <td scope="row" class="text-left text-primary">@adet</td>
                                <td scope="row" class="text-left text-primary">@item.DegerlendirmeID</td>
                                <td scope="row" class="text-left text-primary">@item.TarihSaat</td>
                                <td scope="row" class="text-left text-primary">@item.Degerlendirme</td>
                                
                                <td scope="row" class="text-center">
                                    <a style="color:#FF0000;" , href="@Url.Action("OgrenciDegerlendirmeAdd","OgrenciDegerlendirmeleri", new {id = @item.OgrenciID, area ="AkademikDanismanArea"})">
                                        @* <i style="color:#FF0000;", class="fa-solid fa-check"></i> *@
                                        Sil
                                    </a>

                                </td>
                            </tr>

                            adet++;

                        }
                    }

                    else
                    {
                        <tr>
                            <td class="text-center text-danger" colspan="7">Herhangi bir kayıt bulunamadı.</td>
                        </tr>
                    }

                </table>
            </div>

        </div>
    </div>
</div>





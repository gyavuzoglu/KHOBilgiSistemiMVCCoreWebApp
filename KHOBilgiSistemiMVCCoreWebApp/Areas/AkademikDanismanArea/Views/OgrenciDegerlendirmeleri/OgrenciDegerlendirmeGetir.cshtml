@using EntityLayer.Concrete
@model List<OgrenciDegerlendirmeleriTbl>

@{
    ViewData["Title"] = "Ogrenci Degerlendirmeleri Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-lg">
                <h3 class="text-primary">Öğrenciler Hakkında Yapılan Değerlendirmeler</h3>
            </div>
            <br />

            <div class="col-6 text-end">
                <a href="@Url.Action("OgrenciDegerlendirmeAdd","OgrenciDegerlendirmeleri", new {area ="AkademikDanismanArea"})" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Değerlendirme Yarat</a>

            </div>
        </div>
        <br />
        <div style="width:70%;margin:auto;">
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="10%">Değ.Id</th>
                        <th scope="col" class="text-left" width="10%">Değ.Türü</th>
                        <th scope="col" class="text-left" width="10%">Öğc.Adı</th>
                        <th scope="col" class="text-left" width="10%">Öğc.Soyadı</th>
                        <th scope="col" class="text-left" width="10%">Per.Adı</th>
                        <th scope="col" class="text-left" width="10%">Per.Soyadı</th>
                        <th scope="col" class="text-left" width="20%">Değ.Tarih-Saat</th>
                        <th scope="col" class="text-left" width="30%">Değerlendirme</th>
                        <th scope="col" class="text-left" width="10%">Eğt.Öğt.Yılı</th>
                        <th scope="col" class="text-left" width="10%">Dönem</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>

                    </tr>
                </thead>
                @if (Model.Count() > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">
                            <td scope="row" class="text-left text-primary">@item.DegerlendirmeID</td>
                            <td scope="row" class="text-left text-primary">@item.OgrenciDegerlendirmeTurleriTbl.TurAdi</td>
                            <td scope="row" class="text-left text-primary">@item.OgrencilerTbl.Adi</td>
                            <td scope="row" class="text-left text-primary">@item.OgrencilerTbl.Soyadi</td>
                            <td scope="row" class="text-left text-primary">@item.PersonelTbl.Adi</td>
                            <td scope="row" class="text-left text-primary">@item.PersonelTbl.Soyadi</td>
                            <td scope="row" class="text-left text-primary">@item.TarihSaat</td>
                            <td scope="row" class="text-left text-primary">@item.Degerlendirme</td>
                            <td scope="row" class="text-left text-primary">@item.EOYiliTbl.EOYili</td>
                            <td scope="row" class="text-center">
                                <a href="@Url.Action("OgrenciDegerlendirmeleriniGetir","OgrenciDegerlendirmeleri", new {EOYiliID = @item.EOYiliID, Donem=item.Donem, PerID=item.PerID, area ="AkademikDanismanArea"})">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </a>

                            </td>
                            <td scope="row" class="text-center">
                                <a data-bs-toggle="modal" data-bs-target="#Sil_@item.DegerlendirmeID">
                                    <i class="fa-solid fa-trash text-primary"></i>
                                </a>
                                @* Modal Sil *@
                                <div class="modal fade" id="Sil_@item.DegerlendirmeID" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="SilModalLongTitle">Değerlendirme Silme</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <h5>Bu Değerlendirmeyi silmek istediğinize emin misiniz ? </h5>
                                            </div>
                                            <div class="modal-footer">

                                                @Html.ActionLink("Sil", "OgrenciDegerlendirmeDelete", new { id = @item.DegerlendirmeID, area = "AkademikDanismanArea" }, new { @class = "btn btn-danger" })
                                                <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center text-danger" colspan="4">Herhangi bir kayıt bulunamadı.</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>











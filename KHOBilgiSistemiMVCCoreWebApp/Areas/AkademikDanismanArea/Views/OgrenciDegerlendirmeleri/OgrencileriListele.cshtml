@using EntityLayer.Concrete
@model List<OgrencilerTbl>

@{
    ViewData["Title"] = "Öğrencileri Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-3" style="max-width: 70rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-8">
                <h3 class="text-primary">Öğrenci Değerlendirme İşlemleri</h3>
                <h4 class="text-primary">Eğitim-Öğretim Yılı : ViewBag.EOYili  Dönem : ViewBag.DonemAdi</h4>

            </div>
            <div class="col-4 text-end">
                <a href="@Url.Action("OgrencileriGetir","OgrenciDegerlendirmeleri", new {area ="AkademikDanismanArea"})" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Başka Sınıf-Kısım Seç</a>

            </div>
          
            <div style="width:90%;margin:auto;">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr class="table-primary">
                            <th scope="col" class="text-left" width="8%">Sıra No</th>
                            <th scope="col" class="text-left" width="8%">Sınıf</th>
                            <th scope="col" class="text-left" width="8%">Kısım</th>
                            <th scope="col" class="text-left" width="10%">Yaka No</th>
                            <th scope="col" class="text-left" width="20%">Adı</th>
                            <th scope="col" class="text-left" width="20%">Soyadı</th>
                            <th scope="col" class="text-left" width="20%">Fotoğraf</th>
                            <th scope="col" class="text-center" width="6%"></th>


                        </tr>
                    </thead>
                    @{
                        int adet = 1;
                    }
                    @if (Model.Count() > 0)
                    {
                        @foreach (var item in Model)
                        {
                           <tr class="table-light">
                                <td scope="row" class="text-left text-primary">@adet</td>
                                <td scope="row" class="text-left text-primary">@item.Sinif</td>
                                <td scope="row" class="text-left text-primary">@item.KisimAdi</td>
                                <td scope="row" class="text-left text-primary">@item.YakaNo</td>
                                <td scope="row" class="text-left text-primary">@item.Adi</td>
                                <td scope="row" class="text-left text-primary">@item.Soyadi</td>
                                <td scope="row" class="text-left text-primary">@item.FotografAdresi</td>
                                <td scope="row" class="text-center">
                                    <a style="color:#FF0000;", href="@Url.Action("OgrenciDegerlendirmeAdd","OgrenciDegerlendirmeleri", new {ogrenciId = @item.OgrenciID, Adi=@item.Adi, Soyadi=@item.Soyadi, Sinif=@item.Sinif, KisimAdi=@item.KisimAdi, EOYiliID=ViewBag.EOYiliID, Donem=ViewBag.Donem, area ="AkademikDanismanArea"})">
                                        @* <i style="color:#FF0000;", class="fa-solid fa-check"></i> *@
                                        Seç
                                    </a>

                                </td>
                            </tr>
                            
                            adet++;
                            
                        }
                    }

                    else
                    {
                        <tr>
                            <td class="text-center text-danger" colspan="7">Herhangi bir kayıt bulunamadı.</td>
                        </tr>
                    }

                </table>
            </div>

        </div>
    </div>
</div>





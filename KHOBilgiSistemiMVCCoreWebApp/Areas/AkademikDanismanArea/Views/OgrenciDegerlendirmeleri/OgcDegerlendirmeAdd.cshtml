@model DegerlendirmeGirisClass

@{
    ViewData["Title"] = "Öğrenci Değerlendirme Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<br />
<br />
<div class="card border-primary mb-3" style="max-width: 70rem;margin:auto;">

    <div class="card-header col-md-12">
        <div class="row pt-2">
            <div class="col-md-9">
                <h4 class="text-primary">Öğrenci Değerlendirme Ekleme</h4>
                <h5 class="text-primary">Öğrenci : @Model.Adi @Model.Soyadi</h5>
                <h5 class="text-primary">Sınıf - Kısım - Yaka No : @Model.Sinif / @Model.KisimAdi / @Model.YakaNo</h5>
            </div>
            <div class="col-md-3">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("OgrencileriGetir","OgrenciDegerlendirmeleri",new {area ="AkademikDanismanArea"})" class="btn btn-outline-primary"><i class="fa-solid fa-plus"></i>&nbsp;Başka Sınıf-Kısım Seç</a>
                                       
                    @using (Html.BeginForm("OgrencileriGetir", "OgrenciDegerlendirmeleri", new { Sinif = Model.Sinif, KisimAdi = Model.KisimAdi, EOYiliID = Model.EOYiliID, Donem = Model.Donem }, FormMethod.Post))
                    {

                        <button type="submit" class="btn btn-outline-secondary" style="width:100%;"><i class="fa-solid fa-user-plus"></i>Başka Öğrenci Seç</button>
                    }

                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="card-body col-md-12">
        <div class="row pt-2">
            <div class="col-md-2 ms-md-auto">
                <img src="@Model.Fotograf" width="180" height="220" />
                
            </div>
            
            <div class="col-10" style="max-width: 70rem;margin:auto;">


                @using (Html.BeginForm("OgcDegerlendirmeAdd", "OgrenciDegerlendirmeleri", new { PerID = Model.PerID, EOYiliID = Model.EOYiliID, Donem = Model.Donem, OgrenciID = Model.OgrenciId, TarihSaat = DateTime.Now, Sinif = Model.Sinif, KisimAdi = Model.KisimAdi, Fotograf = Model.Fotograf }, FormMethod.Post))
                {
                    <div class="form-outline mb-4">
                        @* <label>Değerlendirme Türü</label> *@

                        @Html.DropDownListFor(x => x.DegTurID, Model.OgrenciDegerlendirmeTurleriListe, "Değerlendirme Türü Seçiniz", new { @class = "dropdown form-control", @id = "DegTurID" })

                    </div>

                    <div class="form-outline mb-4">
                        <label>Değerlendirmeniz :</label>

                        @Html.TextAreaFor(x => x.Degerlendirme, 5, 80, new { @class = "form-control", @id = "Degerlendirme" })
                    </div>
                    <br />

                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    @Html.ActionLink("Vazgeç", "OgrencileriGetir", "OgrenciDegerlendirmeleri", new { sinif = Model.Sinif, kisimadi = Model.KisimAdi, EOYiliID = Model.EOYiliID, Donem = Model.Donem, area = "AkademikDanismanArea" }, new { @class = "btn btn-secondary" })
                }
            </div>
        </div>
    </div>
      
</div>
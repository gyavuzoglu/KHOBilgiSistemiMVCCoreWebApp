@using KHOBilgiSistemiMVCCoreWebApp.Areas.AkademikDanismanArea.Models
@model List<OgrenciDegerlendirmeList>

@{
    ViewData["Title"] = "Öğrenci Değerlendirme Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-3" style="max-width: 80rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <h3 class="text-primary text-center">
                Öğrencinin Değerlendirmeleri
            </h3>
            <div class="col-2 text-end">
                <img src="@ViewBag.Fotograf" width="100" height="120" />
            </div>
            <div class="col-8">

                <h5 class="text-primary">Eğitim-Öğretim Yılı / Dönemi : @ViewBag.EOYili / @ViewBag.Donem </h5>
                <h5 class="text-primary">Öğrenci Adı Soyadı : @ViewBag.OgrAdi @ViewBag.OgrSoyadi</h5>
                <h5 class="text-primary">Öğrenci Sınıf / Kısım / Yaka No : @ViewBag.Sinif / @ViewBag.KisimAdi / @ViewBag.YakaNo </h5>

            </div>


            <div class="col-2 text-end">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("OgrencileriGetir","OgrenciDegerlendirmeleri", new {area ="AkademikDanismanArea"})" class="btn btn-outline-primary"><i class="fa-solid fa-plus"></i>&nbsp;Başka Sınıf-Kısım Seç</a>
                    <a href="@Url.Action("OgcDegerlendirmeAdd","OgrenciDegerlendirmeleri", new {PerID=ViewBag.PerID, EOYiliID=ViewBag.EOYiliID, OgrenciID=ViewBag.OgrenciID, Donem=ViewBag.Donem, Fotograf=ViewBag.Fotograf, Adi=ViewBag.OgrAdi, Soyadi=ViewBag.OgrSoyadi, Sinif=ViewBag.Sinif, KisimAdi=ViewBag.KisimAdi, area ="AkademikDanismanArea"})" class="btn btn-outline-info"><i class="fa-solid fa-plus"></i>&nbsp;Değerlendirme Ekle</a>
                </div>
            </div>



            <div style="width:90%;margin:auto;">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr class="table-primary">
                            <th scope="col" class="text-center align-middle" width="8%">Sıra No</th>
                            <th scope="col" class="text-center align-middle" width="12%">Değerlendirme ID</th>
                            <th scope="col" class="text-center align-middle" width="18%">Değerlendirme Türü</th>
                            <th scope="col" class="text-center align-middle" width="15%">Tarih-Saat</th>
                            <th scope="col" class="text-center align-middle" width="40%">Değerlendirme</th>
                            <th scope="col" class="text-center align-middle" width="7%">İşlem</th>

                        </tr>
                    </thead>
                    @{
                        int adet = 1;
                    }
                    @if (Enumerable.Count(Model) > 0)
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="table-light">
                                <td scope="row" class="text-center text-primary align-middle">@adet</td>
                                <td scope="row" class="text-center text-primary align-middle">@item.DegerlendirmeID</td>
                                <td scope="row" class="text-left text-primary align-middle">@item.TurAdi</td>
                                <td scope="row" class="text-center text-primary align-middle">@item.TarihSaat</td>
                                <td scope="row" class="text-left text-primary align-middle">@item.Degerlendirme</td>

                                <td scope="row" class="text-center text-primary align-middle">

                                    <a href="@Url.Action("DegerlendirmeGet","OgrenciDegerlendirmeleri", new {id=item.DegerlendirmeID, Sinif=@ViewBag.Sinif, KisimAdi=@ViewBag.KisimAdi,YakaNo=@ViewBag.YakaNo, OgrAdi=@ViewBag.OgrAdi, OgrSoyadi=@ViewBag.OgrSoyadi, FotografAdresi=@ViewBag.Fotograf, area ="AkademikDanismanArea"})">
                                        <i class="fa-solid fa-lg fa-pen-to-square text-primary"></i>
                                    </a>
                                    &nbsp;&nbsp;
                                    <a href="" data-bs-toggle="modal" data-bs-target="#Sil_@item.DegerlendirmeID">
                                        <span title="Değerlendirmeyi Sil"><i class="fa-solid fa-lg fa-trash text-primary"></i></span>
                                    </a>
                                    @* Modal Sil *@
                                    <div class="modal fade" id="Sil_@item.DegerlendirmeID" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="SilModalLongTitle">Değerlendirme Silme</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <h5>Bu Değerlendirmeyi silmek istediğinize emin misiniz ? </h5>
                                                </div>
                                                <div class="modal-footer">

                                                    @Html.ActionLink("Sil", "OgrenciDegerlendirmeDelete", "OgrenciDegerlendirmeleri", new { id = @item.DegerlendirmeID, PerID = @ViewBag.PerID, OgrenciID = @item.OgrenciID, OgrAdi = @ViewBag.OgrAdi, OgrSoyadi = @ViewBag.OgrSoyadi, YakaNo = @ViewBag.YakaNo, Sinif = @ViewBag.Sinif, KisimAdi = @ViewBag.KisimAdi, EOYiliID = @ViewBag.EOYiliID, Donem = @ViewBag.Donem, FotografAdresi=@ViewBag.Fotograf, area = "AkademikDanismanArea" }, new { @class = "btn btn-danger" })
                                                    <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                 

                                </td>
                            </tr>

                            adet++;

                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center text-primary" colspan="6">Herhangi bir kayıt bulunamadı.</td>
                        </tr>
                    }


                </table>
            </div>

        </div>
    </div>
</div>





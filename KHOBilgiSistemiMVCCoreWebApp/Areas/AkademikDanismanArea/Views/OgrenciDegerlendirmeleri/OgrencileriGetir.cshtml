@using KHOBilgiSistemiMVCCoreWebApp.Areas.AkademikDanismanArea.Models.OgrenciDegerlendirmeVM
@model SinifKisimSecmeClass

@{
    ViewData["Title"] = "Ogrenci Degerlendirmeleri Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery-3.7.1.min.js"></script>

<script>
    $(function () {
        $('#Sinif').change(function () {
            var Sinif = $('#Sinif').val();
            $.ajax({
                url: '@Url.Action("KisimGetir", "OgrenciDegerlendirmeleri", new { area = "AkademikDanismanArea" })',
                data: { p: Sinif },
                type: "POST",
                dataType: "JSon",
                success: function (data) {
                    console.log(data);
                    $('#KisimAdi').empty();
                    for (var i = 0; i < data.length; i++) {
                        $('#KisimAdi').append($('<option/>').attr("value", data[i].value).text(data[i].text));

                    }
                }
            });
        });
    });
</script>
<br/>
<br/>
<br/>

<div class="card border-primary mb-3" style="max-width: 40rem;margin:auto;">

    <div class="card-header"><h4>Öğrenci Değerlendirme Yazma </h4></div>
           
    <div class="card-body">
    
          
                @using (Html.BeginForm("OgrencileriGetir", "OgrenciDegerlendirmeleri", new { Sinif = Model.Sinif, KisimAdi = Model.KisimAdi, EOYiliID = Model.EOYiliID, Donem = Model.Donem }, FormMethod.Post))

                {
                    <div class="form-outline mb-2">
                        @Html.DropDownListFor(x => x.EOYiliID, Model.EOYiliListe, "Eğitim-Öğretim Yılı Seçiniz", new { @class = "form-control form-select", @id = "EOYiliID" })
                    </div>

                    <div class="form-outline mb-2">
                        @Html.DropDownListFor(x => x.Donem, Model.DonemlerListe, "Dönem Seçiniz", new { @class = "form-control form-select", @id = "Donem" })
                    </div>

                    <div class="form-outline mb-2">
                        @Html.DropDownListFor(x => x.Sinif, Model.SiniflarListe, "Sınıf Seçiniz", new { @class = "form-control form-select", @id = "Sinif" })
                    </div>

                    <div class="form-outline mb-2">
                        @Html.DropDownListFor(x => x.KisimAdi, Model.KisimlarListe, "Kısım Seçiniz", new { @class = "form-control form-select", @id = "KisimAdi" })
                    </div>

                    <br />
                    <button type="submit" class="btn btn-primary">Öğrencileri Getir</button>
                }
            
    </div>

</div>



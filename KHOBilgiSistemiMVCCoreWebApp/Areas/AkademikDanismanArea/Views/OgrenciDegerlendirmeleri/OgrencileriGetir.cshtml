@using KHOBilgiSistemiMVCCoreWebApp.Areas.AkademikDanismanArea.Models
@model SinifKisimSecmeClass

@{
    ViewData["Title"] = "Ogrenci Degerlendirmeleri Listeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery-3.7.1.min.js"></script>

<script>
    $(function () {
        $('#DrpSiniflar').change(function () {
            var Sinif = $('#DrpSiniflar').val();
            $.ajax({
                url: '@Url.Action("KisimGetir", "OgrenciDegerlendirmeleri", new { area = "AkademikDanismanArea" })',
                data: { p: Sinif },
                type: "POST",
                dataType: "JSon",
                success: function (data) {
                    console.log(data);
                    $('#DrpKisimlar').empty();
                    for (var i = 0; i < data.length; i++) {
                        $('#DrpKisimlar').append($('<option/>').attr("value", data[i].value).text(data[i].text));

                    }
                }
            });
        });
    });
</script>

<div class="mb-3" style="max-width: 70rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-8">
                <h3 class="text-primary">Öğrenci Değerlendirme İşlemleri</h3>
            </div>
            <br />

            <div class="col-4 text-end">
                <a href="@Url.Action("OgrencileriGetir","OgrenciDegerlendirmeleri", new {area ="AkademikDanismanArea"})" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Değerlendirme Oluştur</a>
                
            </div>
        </div>
        <br />
        <div class="col-md-4">
            <div class="row pt-4 align-content-center">
                @using (Html.BeginForm("OgrencileriGetir", "OgrenciDegerlendirmeleri", new { sinif = Model.Sinif, kisimadi=Model.KisimAdi, EOYiliID=Model.EOYiliID, Donem=Model.Donem}, FormMethod.Post))

                {
                    <div class="form-outline mb-4">
                        <label>Eğitim-Öğretim Yılı</label>
                        @Html.DropDownListFor(x => x.EOYiliID, new SelectList(ViewBag.EOYiliListe, "Value", "Text"), "Eğitim-Öğretim Yılı Seçiniz", new { @class = "form-control" })
                    </div>

                    <div class="form-outline mb-4">
                        <label>Dönem</label>
                        @Html.DropDownListFor(x => x.Donem, new SelectList(ViewBag.DonemListe, "Value", "Text"), "Dönem Seçiniz", new { @class = "form-control" })
                    </div>

                    <div class="form-outline mb-4">
                        <label>Okuduğu Sınıf</label>
                        @Html.DropDownListFor(x => x.Sinif, Model.SiniflarTbl, "Sınıf Seçiniz", new { @class = "dropdown form-control", @id = "DrpSiniflar" })
                        
                    </div>

                    <div class="form-outline mb-4">
                        <label>Okuduğu Kısım</label>
                        @Html.DropDownListFor(x => x.KisimAdi, Model.KisimlarTbl, "Kısım Seçiniz", new { @class = "dropdown form-control", @id = "DrpKisimlar" })
                    </div>

                    
                    <br />
                    <button type="submit" class="btn btn-primary">Öğrencileri Listele</button>
                }
            </div>
        </div>
    </div>
</div>



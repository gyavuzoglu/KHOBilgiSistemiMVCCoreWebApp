@using EntityLayer.Concrete
@model AppRolesTbl
@{
    ViewData["Title"] = "RolGüncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Rol Güncelleme</h3>

            <br /><br /><br />

            <div style="width:70%;margin:auto;">
                @using (Html.BeginForm("RoleEdit", "Role", FormMethod.Post))
                {
                    <label style="display:none;">Rol ID</label>
                    @Html.TextBoxFor(x => x.Id, new { style = "display:none;", @class = "form-control" })
                    <label>Rol Adı</label>
                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                    <br />
                    <button class="btn btn-primary">Güncelle</button>

                }
            </div>
        </div>
    </div>
</div>

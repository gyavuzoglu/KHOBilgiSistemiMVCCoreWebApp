@using KHOBilgiSistemiMVCCoreWebApp.Areas.YonetimArea.Models.ViewModels.UserVM
@model RoleViewModel

@{
    ViewData["Title"] = "Rol Ekleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Rol Kayıt</h3>

            <br /><br /><br />
            <div style="width:70%;margin:auto;">

                @using (Html.BeginForm("RoleRegister", "Role", FormMethod.Post))
                {
                    <label style="display:none;">Rol ID</label>
                    @Html.TextBoxFor(x => x.Id, new { style = "display:none;", @class = "form-control" })
                    <label>Rol Adı</label>
                    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger" })
                    <br />

                    <br />

                    <br />
                    <button type="submit" class="btn btn-primary">Ekle</button>

                }

            </div>
        </div>
    </div>
</div>
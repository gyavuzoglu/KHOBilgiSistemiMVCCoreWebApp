@using EntityLayer.Concrete
@model EOYiliTbl
@{
    ViewData["Title"] = "Eğitim-Öğretim Yılı Güncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 60rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="text-primary">Eğitim-Öğretim Yılı Güncelleme</h3>

            <br /><br /><br />

            <div style="width:70%;margin:auto;">
                @using (Html.BeginForm("EOYiliUpdate", "EOYillari", FormMethod.Post))
                {
                    <label style="display:none;">Eğt.-Öğt.Yılı ID</label>
                    @Html.TextBoxFor(x => x.EOYiliID, new { style = "display:none;", @class = "form-control" })
                    <label>Eğt.-Öğt.Yılı</label>
                    @Html.TextBoxFor(x => x.EOYili, new { @class = "form-control" })
                    <br />
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <br />
                    <button class="btn btn-primary">Güncelle</button>
                    @:&nbsp;&nbsp;
                    @Html.ActionLink("Vazgeç", "Index", "EOYillari", new { area = "YonetimArea" }, new { @class = "btn btn-secondary" })

                }
            </div>
        </div>
    </div>
</div>

@using EntityLayer.Concrete
@model BolumTbl
@{
    ViewData["Title"] = "Bölümler Güncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="text-primary">Bölüm Güncelleme</h3>

            <br /><br /><br />

            <div style="width:70%;margin:auto;">
                @using (Html.BeginForm("BolumUpdate", "Bolumler", FormMethod.Post))
                {
                    <label style="display:none;">Bolum ID</label>
                    @Html.TextBoxFor(x => x.BolumID, new { style = "display:none;", @class = "form-control" })
                    <label>Birim Adı</label>
                    @Html.TextBoxFor(x => x.BolumAdi, new { @class = "form-control" })
                    <br />
                    <button class="btn btn-primary">Güncelle</button>

                }
            </div>
        </div>
    </div>
</div>

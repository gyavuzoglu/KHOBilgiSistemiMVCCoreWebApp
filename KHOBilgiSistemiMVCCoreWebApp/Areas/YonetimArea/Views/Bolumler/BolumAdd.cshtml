@using EntityLayer.Concrete
@model BolumTbl

@{
    ViewData["Title"] = "BolumEkleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="text-primary">Bölüm Ekleme</h3>

            <br /><br /><br />
            <div style="width:70%;margin:auto;">
                @using (Html.BeginForm("BolumAdd", "Bolumler", FormMethod.Post))
                {
                    <label style="display:none;">Bölüm ID</label>
                    @Html.TextBoxFor(x => x.BolumID, new { style = "display:none;", @class = "form-control" })
                    <label>Bölüm Adı</label>
                    @Html.TextBoxFor(x => x.BolumAdi, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BolumAdi, "", new { @class = "text-danger" })
                    <br />

                    <br />
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <br />
                    <button type="submit" class="btn btn-primary">Ekle</button>
                    @:&nbsp;&nbsp;
                    @Html.ActionLink("Vazgeç", "Index", "Bolumler", new { area = "YonetimArea" }, new { @class = "btn btn-secondary" })
                }
            </div>
        </div>
    </div>
</div>



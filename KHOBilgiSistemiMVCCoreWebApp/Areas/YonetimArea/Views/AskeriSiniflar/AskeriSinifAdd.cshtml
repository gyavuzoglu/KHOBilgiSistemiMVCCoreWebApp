@{
    ViewData["Title"] = "Askeri Sınıf Add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mt-3">
    <div class="container p-3">
        <h3 class="text-primary"> Askeri Sınıf Ekleme </h3>

        <form method="post" asp-controller="AskeriSiniflar" asp-action="AskeriSinifAdd" asp-area="YonetimArea">

            <label class="form-label">Kısa Sınıf Adı</label>
            <input type="text" class="form-control" name="SinifKisa" />

            <label class="form-label">Uzun Sınıf Adı</label>
            <input type="text" class="form-control" name="SinifUzun" />
            <br/>
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                &nbsp;&nbsp;
                @Html.ActionLink("Vazgeç", "Index", "AskeriSiniflar", new { area = "YonetimArea" }, new { @class = "btn btn-secondary" })
            </div>
        </form>
    </div>

</div>
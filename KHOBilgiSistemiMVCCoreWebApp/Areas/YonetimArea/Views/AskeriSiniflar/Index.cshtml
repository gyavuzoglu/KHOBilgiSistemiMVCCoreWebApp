@using EntityLayer.Concrete
@model List<AskeriSiniflarTbl>
@{
    ViewData["Title"] = "AskeriSinifListeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div style="width:60%;margin:auto;">
    <div class="container p-3">
        <div class="row pt-4">

            <div class="col-lg">
                <h3 class="text-primary">Askeri Sınıf Düzenleme</h3>
            </div>


            <div class="col-6 text-end">
                <a class="btn btn-primary" href="@Url.Action("AskeriSinifAdd","AskeriSiniflar", new {area ="YonetimArea"})"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Askeri Sınıf</a>
            </div>

        </div>

        <br />
        <div style="width:70%;margin:auto;">
            @* tabloyu küçültme *@
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="10%">#</th>
                        <th scope="col" class="text-left" width="40%">Uzun Sınıf Adı</th>
                        <th scope="col" class="text-left" width="40%">Kısa Sınıf Adı</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>

                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr class="table-light">
                        <td scope="row" class="text-left text-primary">@item.SinifID</td>
                        <td scope="row" class="text-left text-primary">@item.SinifUzun</td>
                        <td scope="row" class="text-left text-primary">@item.SinifKisa</td>
                        <td class="text-center" scope="row"><a href="@Url.Action("AskeriSinifUpdate","AskeriSiniflar", new {area ="YonetimArea"})"><i class="fa-solid fa-list text-primary"></i></a></td>
                        <td class="text-center" scope="row"><a href="@Url.Action("AskeriSinifDelete","AskeriSiniflar", new {area ="YonetimArea"})"><i class="fa-solid fa-trash text-primary"></i></a></td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>



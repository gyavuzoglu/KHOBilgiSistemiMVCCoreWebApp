@using EntityLayer.Concrete
@model BirimlerTbl
@{
    ViewData["Title"] = "Birimler Güncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="text-primary">Birim Güncelleme</h3>

            <br /><br /><br />

            <div style="width:70%;margin:auto;">
                @using (Html.BeginForm("BirimUpdate", "Birimler", FormMethod.Post))
                {
                    <label style="display:none;">Birim ID</label>
                    @Html.TextBoxFor(x => x.BirimID, new { style="display:none;", @class = "form-control" })
                    <label>Birim Adı</label>
                    @Html.TextBoxFor(x => x.BirimAdi, new { @class = "form-control" })
                    <br/>
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <br/>
                    <button class="btn btn-primary">Güncelle</button>

                }
            </div>
        </div>
    </div>
</div>

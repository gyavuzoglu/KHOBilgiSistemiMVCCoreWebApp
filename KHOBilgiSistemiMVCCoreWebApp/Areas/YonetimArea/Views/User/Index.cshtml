@using EntityLayer.Concrete
@model List<AppUserTbl>

@{
    ViewData["Title"] = "KullanıcıListeleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<div class="mb-3" style="max-width: 80rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">
            <div class="col-lg">
                <h3 class="card-title">Kullanıcı İşlemleri</h3>
            </div>
            <br />

            <div class="col-6 text-end">
               <a href="@Url.Action("UserRegister","User", new {area ="YonetimArea"})" class="btn btn-primary"><i class="fa-solid fa-plus"></i>&nbsp;Yeni Kullanıcı Yarat</a>
            </div>
        </div>
        <br />
        <div style="width:90%;margin:auto;">
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="table-primary">
                        <th scope="col" class="text-left" width="10%">Id</th>
                        <th scope="col" class="text-left" width="15%">Adı</th>
                        <th scope="col" class="text-left" width="17%">Soyadı</th>
                        <th scope="col" class="text-left" width="15%">Kullanıcı Adı</th>
                        <th scope="col" class="text-left" width="25%">E-Posta Adresi</th>
                        <th scope="col" class="text-center" width="5%">Düzenle</th>
                        <th scope="col" class="text-center" width="5%">Sil</th>
                        <th scope="col" class="text-center" width="8%">Roller</th>


                    </tr>
                </thead>
                @if (Model.Count() > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">
                            <td scope="col" class="text-left" width="10%">@item.Id</td>
                            <td scope="col" class="text-left" width="13%">@item.Adi</td>
                            <td scope="col" class="text-left" width="16%">@item.Soyadi</td>
                            <td scope="col" class="text-left" width="10%">@item.UserName</td>
                            <td scope="col" class="text-left" width="25%">@item.Email</td>
                            
                            <td scope="row" class="text-center">
                                <a href="@Url.Action("UserGet","User", new {id = @item.Id, area ="YonetimArea"})">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </a>

                            </td>
                            <td scope="row" class="text-center">
                                <a data-bs-toggle="modal" data-bs-target="#Sil_@item.Id">
                                    <i class="fa-solid fa-trash text-primary"></i>
                                </a>
                                @* Modal Sil *@
                                <div class="modal fade" id="Sil_@item.Id" tabindex="-1" role="dialog" aria-labelledby="SilModalCenterTitle" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="SilModalLongTitle">Kullanıcı Silme</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <h5>Bu kullanıcıyı silmek istediğinize emin misiniz ? </h5>
                                            </div>
                                            <div class="modal-footer">
                                                @Html.ActionLink("Sil", "UserDelete", new { id = @item.Id, area = "YonetimArea" }, new { @class = "btn btn-danger" })
                                                <button type="reset" class="btn btn-info" data-bs-dismiss="modal">Vazgeç</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td scope="row" class="text-center">
                                <a href="@Url.Action("EditRolesInUsers","User", new {id = @item.Id, area ="YonetimArea"})">
                                    <i class="fa-solid fa-key text-primary"></i>
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center text-danger" colspan="4">Herhangi bir kayıt bulunamadı.</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>











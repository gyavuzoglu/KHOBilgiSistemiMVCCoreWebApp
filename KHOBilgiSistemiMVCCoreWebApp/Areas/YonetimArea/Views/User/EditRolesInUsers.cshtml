@using KHOBilgiSistemiMVCCoreWebApp.Areas.YonetimArea.Models.ViewModels.UserVM
@model List<UserRoleViewModel>
@{
    var userid = ViewBag.Userid;
    var adisoyadi = ViewBag.userAdSoyad;
    ViewData["Title"] = "Rolleri Düzenleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<div class="mb-3" style="max-width: 60rem;margin:auto;">

        @using(Html.BeginForm("EditRolesInUsers","User",FormMethod.Post))
        {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@adisoyadi için Rol Listesi</h3>
            </div>
            <div class="card-body">
      
                @for(int i=0;i<Model.Count();i++)
                {
                    <div class="form-check m-1">
                        @Html.HiddenFor(x=>x[i].RoleID)
                        @Html.CheckBoxFor(x => x[i].IsSelected, new {@class="form-check-input"})
                        @Html.DisplayFor(x => x[i].RoleName)

                    </div>
                }
            </div>
            <div class="card-footer">
                <input type="submit" value="Güncelle" class="btn btn-primary" />
                <a asp-action="Index" asp-controller="User" class="btn btn-primary">Vazgeç</a>
            </div>

        </div>
        }

    </form>
</div>


@using EntityLayer.Concrete
@model AppUserTbl
@{
    ViewData["Title"] = "UserGüncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Kullanıcı Güncelleme</h3>

            <br /><br />

            <div style="width:70%;margin:auto;">
               
                @using (Html.BeginForm("UserUpdate", "User", FormMethod.Post))
                {
                    <label style="display:none;">User ID</label>
                    @Html.TextBoxFor(x => x.Id, new { @style = "display:none;", @class = "form-control" })

                    <br/>
                    @Html.Label("Adı : ")
                    @Html.TextBoxFor(x => x.Adi, new { @class = "form-control", @placeholder = "Adı" })
                    @Html.ValidationMessageFor(x => x.Adi, "", new { @class = "text-danger" })
                    <br />
                    @Html.Label("Soyadı : ")
                    @Html.TextBoxFor(x => x.Soyadi, new { @class = "form-control", @placeholder = "Soyadı" })
                    @Html.ValidationMessageFor(x => x.Soyadi, "", new { @class = "text-danger" })
                    <br />
                    @Html.Label("Kullanıcı Adı : ")
                    @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", @placeholder = "UserName" })
                    @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                    <br />
                    @Html.Label("E-mail : ")
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", @placeholder = "Email"})
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                    <br />

                    @Html.TextBoxFor(x => x.PasswordHash, new { @style = "display:none;", @class = "form-control", @placeholder = "PasswordHash" })
                  
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <br />
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                    @:&nbsp;&nbsp;
                    @Html.ActionLink("Vazgeç", "Index", "User", new { area = "YonetimArea" }, new { @class = "btn btn-secondary" })
                }
            </div>
        </div>
    </div>
</div>

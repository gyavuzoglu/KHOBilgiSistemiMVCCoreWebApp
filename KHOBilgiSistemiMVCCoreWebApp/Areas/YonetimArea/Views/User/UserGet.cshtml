@using EntityLayer.Concrete
@model AppUserTbl
@{
    ViewData["Title"] = "UserGüncelleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />
<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Kullanıcı Güncelleme</h3>

            <br /><br />

            <div style="width:70%;margin:auto;">
               
                @using (Html.BeginForm("UserUpdate", "User", FormMethod.Post))
                {
                    <label style="display:none;">User ID</label>
                    @Html.TextBoxFor(x => x.Id, new { style = "display:none;", @class = "form-control" })

                    <br/>
                    <label>Adı</label>
                    <input type="text" class="mb-3 form-control" asp-for="@Model.Adi" placeholder="Adı" required="" />
                    <span asp-validation-for="@Model.Adi" class="text-danger"></span>
                   
                    <label>Soyadı</label>
                    <input type="text" class="mb-3 form-control" asp-for="@Model.Soyadi" placeholder="Soyadı" required="" />
                    <span asp-validation-for="@Model.Soyadi" class="text-danger"></span>
                    
                    <label>Kullanıcı Adı</label>
                    <input type="text" class="mb-3 form-control" asp-for="@Model.UserName" placeholder="Kullanıcı Adı" required="" />
                    <span asp-validation-for="@Model.UserName" class="text-danger"></span>
                   
                    <label>E-Posta Adresi</label>
                    <input type="text" class="mb-3 form-control" asp-for="@Model.Email" placeholder="E-Posta Adresi" required="" />
                    <span asp-validation-for="@Model.Email" class="text-danger"></span>

                    @* <label>Yeni Şifre</label>
                    <input type="password" class="mb-3 form-control" asp-for="@Model.PasswordHash" required="" />
                    <span asp-validation-for="@Model.PasswordHash" class="text-danger"></span> *@
                   
                    <div asp-validation-summary="All" class="text-danger"> </div>
                    <br />
                    <button type="submit" class="btn btn-primary">Güncelle</button>

                }
            </div>
        </div>
    </div>
</div>

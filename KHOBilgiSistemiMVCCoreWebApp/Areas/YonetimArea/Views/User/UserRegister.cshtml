@using KHOBilgiSistemiMVCCoreWebApp.Areas.YonetimArea.Models.ViewModels.UserVM
@model UserSignUpViewModel
@{
    ViewData["Title"] = "UserRegister";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="mb-3" style="max-width: 50rem;margin:auto;">
    <div class="col-md-12">
        <div class="row pt-4">

            <h3 class="card-title">Kullanıcı Kayıt</h3>

            <br /><br /><br />
            <div style="width:70%;margin:auto;">
                
                @using (Html.BeginForm("UserRegister", "User", FormMethod.Post))
                {
                    <div class="form-group">
                        <div class="m-3">
                            @Html.Label("Adı : ")
                            @Html.TextBoxFor(x => x.Adi, new { @class = "form-control", @placeholder = "Adı" })
                            @Html.ValidationMessageFor(x => x.Adi, "", new { @class = "text-danger" })
                        </div>
                        <div class="m-3">
                            @Html.Label("Soyadı : ")
                            @Html.TextBoxFor(x => x.Soyadi, new { @class = "form-control", @placeholder = "Soyadı" })
                            @Html.ValidationMessageFor(x => x.Soyadi, "", new { @class = "text-danger" })
                        </div>
                        <div class="m-3">
                            @Html.Label("E-Mail Adresi : ")
                            @Html.TextBoxFor(x => x.Email, new { @class = "form-control", @type = "email", @placeholder = "E-Mail Adresi" })
                            @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="m-3">
                            @Html.Label("Kullanıcı Adı : ")
                            @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", @placeholder = "Kullanıcı Adı" })
                            @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                        </div>
                        <div class="m-3">
                            @Html.Label("Şifre : ")
                            @Html.PasswordFor(x => x.Password, new { @class = "form-control", @placeholder = "Şifre" })
                            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                        </div>
                        <div class="m-3">
                            @Html.Label("Tekrar Şifre : ")
                            @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", @placeholder = "Tekrar Şifre" })
                        </div>
                        <div class="m-3">
                            @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>
                        
                    </div>
                                        
                    @Html.ValidationSummary(false, "", new { @class = "text-danger", @summary="ModelOnly"})
                    
                    <br />
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    @:&nbsp;&nbsp;
                    @Html.ActionLink("Vazgeç", "Index", "User", new { area = "YonetimArea" }, new { @class = "btn btn-secondary" })
                    <br />

                }
                
            </div>
        </div>
    </div>
</div>
